# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# Bot token from the Developer Portal (Bot > Reset Token).
DISCORD_TOKEN=paste-bot-token-here

# Application (client) ID — Developer Portal > General Information.
CLIENT_ID=paste-application-id-here

# Your server's ID — right-click the server icon > Copy Server ID
# (needs Developer Mode on: Settings > Advanced > Developer Mode).
GUILD_ID=paste-server-id-here

# Your Discord user ID — right-click your name > Copy User ID.
# ONLY this user can run commands.
OWNER_ID=paste-your-user-id-here

# Optional: lock commands to a single channel. Leave blank to allow the
# whole server (still owner-only).
ALLOWED_CHANNEL_ID=

# Optional: name of the channel the bot auto-creates (default: agent-control).
# CONTROL_CHANNEL_NAME=agent-control

# Optional overrides:
# HERDR_BIN=herdr
# HERDR_TIMEOUT_MS=15000
